# ==============================================================================
# DASMIA HOLDING — Environment Configuration Template (.env.example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# --- Frontend (Next.js 15) ---
PORT=4028
NEXT_PUBLIC_SITE_URL=http://localhost:4028
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Django Core Configuration ---
SECRET_KEY=django-insecure-dasmia-holding-secret-key-development-2026
DEBUG=True
ALLOWED_HOSTS=*

# --- Database (PostgreSQL / SQLite auto-fallback) ---
# Set USE_POSTGRES=True when running PostgreSQL (e.g. via docker compose up -d)
# If PostgreSQL is unreachable, the backend gracefully falls back to SQLite
USE_POSTGRES=False
POSTGRES_DB=dasmia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Bitrix24 CRM Integration ---
# Webhook URL format: https://your-domain.bitrix24.ru/rest/1/your-webhook-code/
BITRIX_WEBHOOK_URL=

# --- Celery & Redis Background Worker ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
